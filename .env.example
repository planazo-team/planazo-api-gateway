# Puerto donde escucha el gateway
PORT=8080

# Secreto para firmar/verificar los JWT. En local puede ser cualquier cosa;
# en Railway genera uno largo y aleatorio y no lo compartas.
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# URLs de los otros servicios (en local, cada quien los corre en su puerto;
# en Railway, la URL pública que te da cada servicio desplegado)
BOOKING_URL=http://localhost:3001
PROMO_URL=http://localhost:3002
GAME_URL=http://localhost:3003

# Para el módulo /plan (agente). Si se deja vacío, /plan responde con una
# plantilla simple en vez de llamar al modelo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
