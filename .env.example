# ── Servidor ─────────────────────────────────────────────────────────────────
PORT=8080
# En Railway pon NODE_ENV=production: con eso el gateway se niega a arrancar
# si JWT_SECRET o GATEWAY_KEY faltan o son cortos.
NODE_ENV=development

# ── Secretos ─────────────────────────────────────────────────────────────────
# Firma y verifica los JWT (HS256). Lo comparten gateway, game y realtime (los
# dos últimos verifican el token por su cuenta). En game se llama JWT_SECRETO y
# debe tener EXACTAMENTE el mismo valor. Mínimo 32 caracteres: Java rechaza
# claves más cortas. Genera uno con: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Secreto que el gateway envía a booking/promo/game en el header x-gateway-key.
# Los servicios rechazan cualquier petición sin él, así nadie puede llamarlos
# directo inventándose los headers x-user-*. Mismo valor en los cuatro.
GATEWAY_KEY=cambia-esto-tambien

# ── Inicio de sesión con Google ──────────────────────────────────────────────
# Client ID de OAuth (tipo «Aplicación web») de Google Cloud Console. Es el
# mismo NEXT_PUBLIC_GOOGLE_CLIENT_ID del frontend. Sin él, /api/auth/google
# responde 503. Se pueden aceptar varios separados por coma.
GOOGLE_CLIENT_ID=

# Llave de POST /api/auth/demo (usuarios semilla para k6 y las pruebas). Si se
# deja vacía la ruta no existe: el único login es Google.
DEMO_LOGIN_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos separados por coma. En producción: la URL de Vercel.
ALLOWED_ORIGINS=http://localhost:3000

# ── Servicios destino ────────────────────────────────────────────────────────
# En local, cada quien corre el suyo en su puerto. En Railway, la URL privada
# (http://booking.railway.internal:3001) o la pública de cada servicio.
BOOKING_URL=http://localhost:3001
PROMO_URL=http://localhost:3002
GAME_URL=http://localhost:3003
UPSTREAM_TIMEOUT_MS=10000

# ── Límite de peticiones por IP y minuto ─────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ── Módulo agent (/api/plan) ─────────────────────────────────────────────────
# Si se deja vacío, /plan responde con una plantilla sobre el catálogo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
